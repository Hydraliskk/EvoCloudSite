---
import BaseLayout from "../layouts/BaseLayout.astro";
import { servicesOverview } from "../lib/services-data";

const iconLabels: Record<string, string> = {
  monitor: "Gestion TI",
  shield: "Protection",
  cloud: "Collaboration",
  backup: "Continuité",
  server: "Infrastructure",
  network: "Connectivité"
};

const accentBySlug: Record<
  string,
  { border: string; text: string; hoverBorder: string; soft: string }
> = {
  "services-ti-geres": {
    border: "border-blue-300/45",
    text: "text-blue-300",
    hoverBorder: "hover:border-blue-100/60",
    soft: "bg-blue-300/12"
  },
  "microsoft-365": {
    border: "border-sky-300/45",
    text: "text-sky-300",
    hoverBorder: "hover:border-sky-100/60",
    soft: "bg-sky-300/12"
  },
  "materiel-licences": {
    border: "border-orange-300/45",
    text: "text-orange-300",
    hoverBorder: "hover:border-orange-100/60",
    soft: "bg-orange-300/12"
  },
  cybersecurite: {
    border: "border-emerald-300/45",
    text: "text-emerald-300",
    hoverBorder: "hover:border-emerald-100/60",
    soft: "bg-emerald-300/12"
  },
  "sauvegarde-continuite": {
    border: "border-rose-300/45",
    text: "text-rose-300",
    hoverBorder: "hover:border-rose-100/60",
    soft: "bg-rose-300/12"
  },
  "cloud-infrastructure": {
    border: "border-violet-300/45",
    text: "text-violet-300",
    hoverBorder: "hover:border-violet-100/60",
    soft: "bg-violet-300/12"
  },
  "reseau-telecommunications": {
    border: "border-cyan-300/45",
    text: "text-cyan-300",
    hoverBorder: "hover:border-cyan-100/60",
    soft: "bg-cyan-300/12"
  }
};
---

<BaseLayout title="Services | Evolution Cloud" description="Découvrez nos services TI, cybersécurité, Microsoft 365, sauvegarde, infrastructure et réseau.">
  <main class="overflow-hidden">
    <section class="relative isolate mx-auto max-w-6xl px-6 py-16 md:py-24">
      <div class="absolute -left-16 top-8 h-64 w-64 rounded-full bg-cyan-400/12 blur-3xl"></div>
      <div class="absolute right-0 top-16 h-72 w-72 rounded-full bg-blue-500/12 blur-3xl"></div>

      <div class="relative max-w-3xl">
        <p class="inline-flex w-fit rounded-full border border-cyan-300/50 bg-white/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-cyan-200 shadow-sm backdrop-blur">
          Services
        </p>
        <h1 class="mt-5 text-4xl font-semibold tracking-tight text-white md:text-5xl">
          Une structure claire pour vos besoins TI.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Voici nos grands volets de service. Chaque bloc mène vers une page détaillée pour vous aider à comprendre ce que nous faisons et comment nous pouvons vous accompagner.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 pb-20 md:pb-28">
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {servicesOverview.map((service) => {
          const accent = accentBySlug[service.slug] ?? accentBySlug["services-ti-geres"];

          return (
            <a
              href={`/services/${service.slug}/`}
              class:list={[
                "group rounded-[2rem] border bg-[linear-gradient(180deg,rgba(4,10,24,0.95),rgba(10,18,38,0.94))] p-6 shadow-[0_28px_72px_-36px_rgba(14,165,233,0.48)] ring-1 ring-cyan-200/20 transition duration-300 hover:-translate-y-1 hover:shadow-[0_32px_82px_-34px_rgba(34,211,238,0.54)]",
                accent.border,
                accent.hoverBorder
              ]}
            >
              <p class={`text-xs font-semibold uppercase tracking-[0.24em] ${accent.text}`}>
                {iconLabels[service.icon]}
              </p>
              <h2 class={`mt-3 text-2xl font-semibold tracking-tight ${accent.text}`}>
                {service.title}
              </h2>
              <p class="mt-3 text-sm leading-7 text-slate-300">
                {service.description}
              </p>
              <div class="mt-5 flex flex-wrap gap-2">
                {service.points.map((point) => (
                  <span class={`rounded-full border px-3 py-1 text-xs font-medium text-slate-200 ${accent.border} ${accent.soft}`}>
                    {point}
                  </span>
                ))}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
