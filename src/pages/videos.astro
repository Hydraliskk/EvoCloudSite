---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredVideo, youtubeChannelUrl } from "../lib/videos-data";
---

<BaseLayout
  title="Vidéos | Conseils TI et cybersécurité | Evolution Cloud"
  description="Découvrez les vidéos EvolutionCloud sur la cybersécurité, Microsoft 365, les services TI, la sauvegarde et les technologies pour entreprises."
  canonical="/videos"
>
  <main class="overflow-hidden">
    <section class="relative isolate mx-auto max-w-7xl px-6 py-16 md:py-24">
      <div class="absolute -left-24 top-10 h-72 w-72 rounded-full bg-cyan-400/12 blur-3xl"></div>
      <div class="absolute -right-16 top-8 h-80 w-80 rounded-full bg-blue-500/12 blur-3xl"></div>

      <div class="max-w-3xl">
        <h1 class="mt-5 text-4xl font-semibold tracking-tight text-white md:text-6xl">
          Nos vidéos
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          Découvrez nos conseils, solutions et technologies pour mieux comprendre l'informatique d'entreprise, la cybersécurité et les services infonuagiques.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-16 md:pb-24">
      <div class="grid gap-8 rounded-[2.5rem] border border-cyan-300/30 bg-[linear-gradient(180deg,rgba(4,10,24,0.95),rgba(2,6,23,0.98))] px-4 py-5 shadow-[0_36px_120px_-44px_rgba(14,165,233,0.44)] ring-1 ring-cyan-200/18 md:grid-cols-[1.25fr_0.95fr] md:px-6 md:py-8">
        <article class="overflow-hidden rounded-[2rem] border border-cyan-300/20 bg-[linear-gradient(180deg,rgba(4,10,24,0.96),rgba(2,6,23,0.98))] shadow-[0_30px_84px_-38px_rgba(14,165,233,0.42)] ring-1 ring-cyan-200/12">
          <div class="relative aspect-video overflow-hidden bg-slate-950">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${featuredVideo.youtubeId}?rel=0&modestbranding=1&playsinline=1`}
              title={featuredVideo.title}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              class="absolute inset-0 h-full w-full"
            ></iframe>
            <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(2,6,23,0.08),rgba(2,6,23,0.16))]"></div>
          </div>

          <div class="space-y-3 p-5 md:p-6">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full border border-cyan-300/20 bg-cyan-300/8 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-cyan-200">
                Vidéo
              </span>
              <span class="rounded-full border border-slate-700 bg-white/5 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-slate-300">
                {featuredVideo.duration}
              </span>
            </div>
            <h2 class="text-2xl font-semibold tracking-tight text-white md:text-[1.6rem]">
              {featuredVideo.title}
            </h2>
            <p class="text-sm leading-6 text-slate-300">
              {featuredVideo.description}
            </p>
          </div>
        </article>

        <aside class="rounded-[2rem] border border-cyan-300/18 bg-white/5 p-6 shadow-[0_24px_80px_-34px_rgba(14,165,233,0.4)]">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-cyan-300">Découvrez nos vidéos </p>
          <h2 class="mt-4 text-2xl font-semibold tracking-tight text-white">
            Une nouvelle vidéo chaque semaine
          </h2>
          <p class="mt-4 text-sm leading-7 text-slate-300">
            Restez à l'affut pour les prochaines nouveautés
          </p>
        </aside>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-16 md:pb-20">
      <div class="grid gap-6 rounded-[2.5rem] border border-cyan-300/40 bg-[linear-gradient(180deg,rgba(4,10,24,0.96),rgba(2,6,23,1))] px-7 py-10 shadow-[0_38px_118px_-36px_rgba(14,165,233,0.48)] ring-1 ring-cyan-200/24 md:grid-cols-[1.2fr_auto] md:items-end md:px-10">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Chaîne YouTube</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white md:text-4xl">
            Retrouvez aussi nos publications et nos prochaines capsules.
          </h2>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-300">
            Si vous voulez suivre nos nouveautés, nos démonstrations et nos conseils pratiques, la chaîne est le meilleur point de départ.
          </p>
        </div>
        <a
          href={youtubeChannelUrl}
          target="_blank"
          rel="noreferrer"
          class="inline-flex w-fit items-center justify-center rounded-full border border-cyan-300/30 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-cyan-300/12"
        >
          Ouvrir la chaîne YouTube
        </a>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 pb-20 md:pb-28">
      <div class="rounded-[2.5rem] border border-cyan-300/50 bg-[linear-gradient(180deg,rgba(4,10,24,0.96),rgba(2,6,23,1))] px-7 py-10 text-white shadow-[0_38px_118px_-36px_rgba(14,165,233,0.48)] ring-1 ring-cyan-200/26 md:px-10">
        <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-300">Besoin d’un appui?</p>
            <h2 class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight md:text-4xl">
              Parlons de vos besoins et trouvons la bonne approche ensemble.
            </h2>
            <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-300">
              Que ce soit pour la cybersécurité, Microsoft 365, les services TI ou l’infrastructure, nous pouvons vous orienter rapidement.
            </p>
          </div>
          <a href="/contact" class="inline-flex w-fit rounded-full border border-cyan-300/30 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-cyan-300/12">
            Parler à un expert
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
