---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

const { title = "Evolution Cloud" } = Astro.props;
const description =
  "Evolution Cloud accompagne les entreprises avec des solutions TI, de cybersÃ©curitÃ©, de cloud, de conformitÃ© et de support technique.";
---

<!doctype html>
<html lang="fr" class="bg-slate-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09111f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script is:inline>
      const paletteKey = "ec_palette";
      const params = new URLSearchParams(window.location.search);
      const paletteParam = params.get("palette");

      if (paletteParam === "light") {
        localStorage.setItem(paletteKey, "light-test");
      } else if (paletteParam === "dark" || paletteParam === "default") {
        localStorage.setItem(paletteKey, "original");
      }

      const palette = localStorage.getItem(paletteKey) || "original";
      document.documentElement.dataset.palette = palette;
    </script>
    <title>{title}</title>
  </head>
  <body class="min-h-dvh text-slate-100 antialiased">
    <Header />
    <slot />
    <Footer />
    <CookieBanner />
  </body>
</html>
