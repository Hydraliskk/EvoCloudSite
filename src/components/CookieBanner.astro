---
const gaMeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim();
---

<div
  id="cookie-consent-banner"
  class="fixed inset-x-0 bottom-0 z-[60] hidden px-4 pb-4 pt-4 sm:px-6 sm:pb-6"
  aria-live="polite"
  aria-label="Gestion du consentement aux cookies"
>
  <div class="mx-auto max-w-5xl rounded-[1.8rem] border border-cyan-300/24 bg-[linear-gradient(180deg,rgba(4,10,24,0.98),rgba(2,6,23,0.99))] p-5 shadow-[0_28px_100px_-40px_rgba(14,165,233,0.55)] ring-1 ring-cyan-200/20 backdrop-blur-xl sm:p-6">
    <div class="grid gap-4 md:grid-cols-[1.35fr_auto] md:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-cyan-300">Cookies et statistiques</p>
        <p class="mt-3 text-sm leading-7 text-slate-300">
          Pour offrir les meilleures expériences, nous utilisons des technologies telles que les témoins pour stocker et/ou accéder aux informations des appareils. Le fait de consentir à ces technologies nous permettra de traiter des données telles que le comportement de navigation ou les ID uniques sur ce site. Le fait de ne pas consentir ou de retirer son consentement peut avoir un effet négatif sur certaines caractéristiques et fonctions.
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row md:justify-end">
        <button
          type="button"
          data-cookie-deny
          class="rounded-full border border-slate-600/80 bg-white/5 px-5 py-3 text-sm font-semibold text-slate-200 transition hover:border-slate-400 hover:bg-white/10 hover:text-white"
        >
          Refuser
        </button>
        <button
          type="button"
          data-cookie-accept
          class="rounded-full border border-cyan-100/60 bg-[linear-gradient(135deg,rgba(34,211,238,0.44),rgba(59,130,246,0.4))] px-5 py-3 text-sm font-semibold text-white shadow-[0_0_0_1px_rgba(34,211,238,0.18)_inset,0_0_30px_rgba(34,211,238,0.28)] transition hover:-translate-y-0.5 hover:border-cyan-50/75 hover:bg-[linear-gradient(135deg,rgba(34,211,238,0.54),rgba(59,130,246,0.5))]"
        >
          Accepter
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ gaMeasurementId }}>
  const COOKIE_NAME = "ec_cookie_consent";
  const GA_SCRIPT_ID = "ga4-gtag-script";
  const banner = document.getElementById("cookie-consent-banner");
  const acceptButton = banner?.querySelector("[data-cookie-accept]");
  const denyButton = banner?.querySelector("[data-cookie-deny]");
  const manageButtons = document.querySelectorAll("[data-cookie-manage]");
  const disableKey = gaMeasurementId ? `ga-disable-${gaMeasurementId}` : "";

  const readCookie = (name) => {
    const entry = document.cookie.split("; ").find((part) => part.startsWith(`${name}=`));
    return entry ? decodeURIComponent(entry.split("=").slice(1).join("=")) : "";
  };

  const setCookie = (value) => {
    const secureFlag = window.location.protocol === "https:" ? "; Secure" : "";
    document.cookie = `${COOKIE_NAME}=${encodeURIComponent(value)}; Max-Age=${60 * 60 * 24 * 365}; Path=/; SameSite=Lax${secureFlag}`;
  };

  const deleteCookieEverywhere = (name) => {
    const secureFlag = window.location.protocol === "https:" ? "; Secure" : "";
    const host = window.location.hostname;
    const domainVariants = [undefined, host];

    if (host.includes(".") && !/^(\d{1,3}\.){3}\d{1,3}$/.test(host)) {
      domainVariants.push(`.${host}`);
    }

    for (const domain of domainVariants) {
      const domainPart = domain ? `; Domain=${domain}` : "";
      document.cookie = `${name}=; Max-Age=0; Path=/; SameSite=Lax${domainPart}${secureFlag}`;
    }
  };

  const clearAnalyticsCookies = () => {
    const names = document.cookie
      .split("; ")
      .map((pair) => pair.split("=")[0])
      .filter(Boolean);

    for (const name of names) {
      if (name === "_ga" || name === "_gid" || name === "_gat" || name.startsWith("_ga_")) {
        deleteCookieEverywhere(name);
      }
    }
  };

  const loadGoogleAnalytics = () => {
    if (!gaMeasurementId || document.getElementById(GA_SCRIPT_ID)) {
      return;
    }

    window[disableKey] = false;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag() {
      window.dataLayer.push(arguments);
    };

    window.gtag("js", new Date());
    window.gtag("config", gaMeasurementId, {
      anonymize_ip: true
    });

    const script = document.createElement("script");
    script.id = GA_SCRIPT_ID;
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId)}`;
    document.head.appendChild(script);
  };

  const hideBanner = () => banner?.classList.add("hidden");
  const showBanner = () => banner?.classList.remove("hidden");
  const openBanner = () => {
    showBanner();
    banner?.scrollIntoView({ behavior: "smooth", block: "end" });
  };

  window.EvolutionCloudCookieConsent = {
    open: openBanner
  };

  const storedConsent = readCookie(COOKIE_NAME);

  if (storedConsent === "accepted") {
    loadGoogleAnalytics();
    hideBanner();
  } else if (storedConsent === "rejected") {
    if (disableKey) {
      window[disableKey] = true;
    }
    clearAnalyticsCookies();
    hideBanner();
  } else {
    showBanner();
  }

  acceptButton?.addEventListener("click", () => {
    setCookie("accepted");
    loadGoogleAnalytics();
    hideBanner();
  });

  denyButton?.addEventListener("click", () => {
    setCookie("rejected");
    if (disableKey) {
      window[disableKey] = true;
    }
    clearAnalyticsCookies();
    hideBanner();
  });

  manageButtons.forEach((button) => {
    button.addEventListener("click", () => {
      openBanner();
    });
  });
</script>
