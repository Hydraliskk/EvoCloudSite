---
import VideoCard from "./VideoCard.astro";
import type { VideoCategory } from "../lib/videos-data";

export interface Props {
  category: VideoCategory;
}

const { category } = Astro.props;
---

<section class="space-y-5">
  <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.22em] text-cyan-300">{category.title}</p>
      <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-300">{category.description}</p>
    </div>
  </div>

  <div class="video-track flex gap-4 overflow-x-auto pb-2 pt-1 md:gap-5" data-video-track>
    {category.videos.map((video) => (
      <VideoCard {...video} />
    ))}
  </div>
</section>
