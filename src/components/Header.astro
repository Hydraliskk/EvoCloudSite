---
import { servicesNavLinks } from "../lib/services-data";

const pathname = Astro.url.pathname;

const mainNav = [
  { href: "/services/", label: "Nos Services" },
  { href: "/a-propos", label: "Notre équipe" },
  { href: "/realisations", label: "Réalisations" },
  { href: "/videos", label: "Vidéos" }
];

const isActive = (href: string) =>
  pathname === href || (href !== "/" && pathname.startsWith(href));

const serviceAccentByHref: Record<string, { text: string; bg: string; border: string }> = {
  "/services/services-ti-geres/": { text: "text-blue-200", bg: "hover:bg-blue-300/10", border: "border-blue-300/20" },
  "/services/microsoft-365/": { text: "text-sky-200", bg: "hover:bg-sky-300/10", border: "border-sky-300/20" },
  "/services/materiel-licences/": { text: "text-orange-200", bg: "hover:bg-orange-300/10", border: "border-orange-300/20" },
  "/services/cybersecurite/": { text: "text-emerald-200", bg: "hover:bg-emerald-300/10", border: "border-emerald-300/20" },
  "/services/securite-batiment/": { text: "text-orange-200", bg: "hover:bg-orange-300/10", border: "border-orange-300/20" },
  "/services/sauvegarde-continuite/": { text: "text-rose-200", bg: "hover:bg-rose-300/10", border: "border-rose-300/20" },
  "/services/cloud-infrastructure/": { text: "text-violet-200", bg: "hover:bg-violet-300/10", border: "border-violet-300/20" },
  "/services/reseau-telecommunications/": { text: "text-cyan-200", bg: "hover:bg-cyan-300/10", border: "border-cyan-300/20" },
  "/services/loi-25/": { text: "text-fuchsia-200", bg: "hover:bg-fuchsia-300/10", border: "border-fuchsia-300/20" }
};
---

<header class="sticky top-0 z-50 border-b border-cyan-300/10 bg-[linear-gradient(180deg,rgba(4,10,24,0.84),rgba(10,18,38,0.62))] backdrop-blur-xl">
  <div class="mx-auto max-w-[88rem] px-4 py-3 md:px-6 md:py-4">
    <div class="flex items-center gap-4 md:gap-6">
      <a href="/" class="flex min-w-0 items-center gap-3 md:gap-5">
        <img
          src="/images/Logo.png"
          alt="Evolution Cloud"
          class="h-[4.25rem] w-auto shrink-0 drop-shadow-[0_0_26px_rgba(34,211,238,0.24)] md:h-[4.95rem]"
        />
        <div class="min-w-0">
          <div class="truncate text-[1.05rem] font-extrabold tracking-tight text-white md:text-[1.45rem] lg:text-[1.85rem]">
            Evolution Cloud
          </div>
          <div class="truncate text-[0.63rem] font-semibold uppercase tracking-[0.26em] text-cyan-300 md:text-[0.7rem]">
            Services TI & cybersécurité
          </div>
        </div>
      </a>

      <div class="hidden flex-1 md:block">
        <div class="mx-auto flex max-w-[58rem] items-center justify-center rounded-[0.95rem] border border-cyan-300/10 bg-[linear-gradient(180deg,rgba(6,11,28,0.92),rgba(10,18,38,0.9))] px-4 py-3 shadow-[0_18px_44px_-30px_rgba(14,165,233,0.36)]">
          <nav class="flex flex-wrap items-center justify-center gap-2 lg:gap-4">
            {mainNav.map((item) => (
              item.href === "/services/" ? (
                <div class="relative">
                  <details class="group relative" data-services-dropdown>
                    <summary
                      class:list={[
                        "cursor-pointer list-none rounded-full px-4 py-2 text-sm font-semibold transition outline-none",
                        pathname.startsWith("/services") ? "text-cyan-100" : "text-slate-200 hover:text-cyan-100"
                      ]}
                    >
                      {item.label}
                    </summary>
                    <div class="absolute left-1/2 top-full z-20 mt-2 w-[20rem] -translate-x-1/2 overflow-hidden rounded-[1.25rem] border border-cyan-300/18 bg-[linear-gradient(180deg,rgba(4,10,24,0.98),rgba(2,6,23,0.98))] p-2 shadow-[0_24px_80px_-34px_rgba(14,165,233,0.6)]">
                      {servicesNavLinks.map((serviceItem) => {
                        const accent = serviceAccentByHref[serviceItem.href] ?? {
                          text: "text-slate-300",
                          bg: "hover:bg-cyan-300/8",
                          border: "border-transparent"
                        };

                        return (
                          <a
                            href={serviceItem.href}
                            class:list={[
                              "block rounded-xl border-l-2 px-3 py-2 text-sm transition",
                              accent.border,
                              accent.text,
                              accent.bg,
                              pathname === serviceItem.href || pathname.startsWith(serviceItem.href) ? "bg-white/10" : "bg-transparent"
                            ]}
                          >
                            {serviceItem.label}
                          </a>
                        );
                      })}
                    </div>
                  </details>
                </div>
              ) : (
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "rounded-full px-4 py-2 text-sm font-semibold transition",
                    isActive(item.href) ? "text-cyan-100" : "text-slate-200 hover:text-cyan-100"
                  ]}
                >
                  {item.label}
                </a>
              )
            ))}
          </nav>
        </div>
      </div>

      <div class="ml-auto hidden items-center gap-4 md:flex md:pt-0">
        <a
          href="/contact"
          class="shrink-0 rounded-full border border-cyan-100/60 bg-[linear-gradient(135deg,rgba(34,211,238,0.44),rgba(59,130,246,0.4))] px-4 py-[0.45rem] text-sm font-semibold text-white shadow-[0_0_0_1px_rgba(34,211,238,0.2)_inset,0_0_30px_rgba(34,211,238,0.32),0_12px_24px_-16px_rgba(14,165,233,0.72)] transition hover:-translate-y-0.5 hover:border-cyan-50/75 hover:bg-[linear-gradient(135deg,rgba(34,211,238,0.54),rgba(59,130,246,0.5))] md:px-[1.15rem] md:py-[0.62rem] md:text-sm"
        >
          Demande de service
        </a>
        <a
          href="tel:+14184769408"
          class="hidden flex-col items-center justify-center whitespace-nowrap rounded-full border border-cyan-200/46 bg-[linear-gradient(135deg,rgba(34,211,238,0.2),rgba(59,130,246,0.2))] px-4 py-[0.42rem] text-center font-semibold tracking-[0.04em] text-cyan-50 shadow-[0_0_0_1px_rgba(34,211,238,0.12)_inset,0_0_28px_rgba(34,211,238,0.26)] transition hover:-translate-y-0.5 hover:border-cyan-100/70 hover:bg-[linear-gradient(135deg,rgba(34,211,238,0.3),rgba(59,130,246,0.28))] hover:shadow-[0_0_0_1px_rgba(34,211,238,0.18)_inset,0_0_36px_rgba(34,211,238,0.36)] md:inline-flex md:px-5 md:py-[0.58rem]"
        >
          <span class="text-[0.64rem] uppercase tracking-[0.2em] text-cyan-200/95">Nous joindre</span>
          <span class="text-[0.95rem] tracking-[0.02em] text-cyan-50">418-476-9408</span>
        </a>
      </div>

      <details class="group relative md:hidden" data-mobile-menu>
        <summary class="flex list-none items-center justify-center rounded-full border border-cyan-300/20 bg-white/5 p-3 text-cyan-100 shadow-[0_18px_44px_-30px_rgba(14,165,233,0.36)] outline-none">
          <span class="sr-only">Ouvrir le menu</span>
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
          </svg>
        </summary>

        <div class="absolute right-0 top-full mt-3 w-[min(22rem,calc(100vw-2rem))] overflow-hidden rounded-[1.2rem] border border-cyan-300/18 bg-[linear-gradient(180deg,rgba(4,10,24,0.99),rgba(2,6,23,0.99))] p-3 shadow-[0_30px_100px_-40px_rgba(14,165,233,0.8)]">
          <div class="space-y-2">
            <a href="/contact" class="block rounded-xl border border-cyan-300/20 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-cyan-300/10">Demande de service</a>
            <a href="tel:+14184769408" class="block rounded-xl border border-cyan-300/20 bg-white/5 px-4 py-3 text-sm font-semibold text-white transition hover:bg-cyan-300/10">418-476-9408</a>
          </div>
          <div class="mt-3 space-y-2">
            {mainNav.map((item) => (
              item.href === "/services/" ? (
                <details class="rounded-xl border border-cyan-300/12 bg-white/3 px-3 py-2">
                  <summary class="cursor-pointer list-none rounded-lg px-1 py-2 text-sm font-semibold text-slate-100">
                    {item.label}
                  </summary>
                  <div class="mt-2 space-y-1 pb-1">
                    {servicesNavLinks.map((serviceItem) => {
                      const accent = serviceAccentByHref[serviceItem.href] ?? {
                        text: "text-slate-300",
                        bg: "hover:bg-cyan-300/8",
                        border: "border-transparent"
                      };

                      return (
                        <a
                          href={serviceItem.href}
                          class:list={[
                            "block rounded-lg border-l-2 px-3 py-2 text-sm transition",
                            accent.border,
                            accent.text,
                            accent.bg
                          ]}
                        >
                          {serviceItem.label}
                        </a>
                      );
                    })}
                  </div>
                </details>
              ) : (
                <a href={item.href} class="block rounded-xl border border-cyan-300/12 bg-white/3 px-4 py-3 text-sm font-semibold text-slate-100 transition hover:bg-white/8">
                  {item.label}
                </a>
              )
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const desktopDropdown = document.querySelector("[data-services-dropdown]");
    const mobileMenu = document.querySelector("[data-mobile-menu]");

    const closeDetails = (details) => {
      if (details && details.hasAttribute("open")) {
        details.removeAttribute("open");
      }
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;

      if (desktopDropdown && !desktopDropdown.contains(target)) {
        closeDetails(desktopDropdown);
      }

      if (mobileMenu && !mobileMenu.contains(target)) {
        closeDetails(mobileMenu);
      }
    });

    document.addEventListener("focusin", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (mobileMenu && !mobileMenu.contains(target)) {
        closeDetails(mobileMenu);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeDetails(desktopDropdown);
        closeDetails(mobileMenu);
      }
    });
  })();
</script>
