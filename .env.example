# Public browser configuration
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only Turnstile configuration
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=evolutioncloud.net,www.evolutioncloud.net,test.evolutioncloud.net

# Set true only if the front proxy overwrites and controls X-Forwarded-For.
TRUST_PROXY_CLIENT_IP=false

# SMTP configuration. Use SMTP_URL or the individual SMTP settings.
SMTP_URL=smtps://username:password@smtp.example.com:465
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example-user
SMTP_PASS=example-password
CONTACT_TO_EMAIL=info@example.com
CONTACT_FROM_EMAIL=website@example.com
